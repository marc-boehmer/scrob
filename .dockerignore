# Documentation / assets — not needed in the image
docs/

# Dev tooling
.git/
.github/
*.md
AGENTS.md
CLAUDE.md

# Dev DB and local env
.testdb/
.env
*.env
.env.*
backend/.env.test.local

# Local envs & caches — docker build only honors the root .dockerignore
# (backend/.dockerignore is silently ignored), so without these the host's
# .venv / node_modules overwrite the ones built inside the image (uv sync / npm ci)
**/.venv/
**/venv/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/


# Test files
test.http
docker-compose-test-db.yaml

# Local build artifacts and runtime data - recreated inside the image, and a
# local build would otherwise bake dev data and a host-specific venv into it
backend/.venv/
backend/data/
backend/node_modules/
backend/.pytest_cache/
frontend/node_modules/
frontend/dist/
frontend/.astro/
**/__pycache__/
*.log
*.pid
docker-compose-test-db.yaml
