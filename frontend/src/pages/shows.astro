---
import Base from "../layouts/Base.astro";
import MediaCard from "../components/MediaCard.astro";
import Pagination from "../components/Pagination.astro";
import FilterPanel from "../components/FilterPanel.astro";
import SortButton from "../components/SortButton.astro";
import { api, type MediaItem } from "../lib/api";
import { MY_RATING_OPTIONS, parseMyRating } from "../lib/my-rating";
import { genreLabel, languageName, showStatusLabel, sortByLabel } from "../lib/labels";
import { m } from "../paraglide/messages.js";
import { exploreLanguageOptions } from "../lib/explore-languages";
export const prerender = false;

const category = Astro.url.searchParams.get("category") ?? "popular";
const genre = Astro.url.searchParams.getAll("genre");
const excludedGenres = Astro.url.searchParams.getAll("exclude_genre");
const year = Astro.url.searchParams.getAll("year").map(Number);
const minRating = Astro.url.searchParams.get("min_rating") ? Number(Astro.url.searchParams.get("min_rating")) : undefined;
const status = Astro.url.searchParams.get("status") ?? "";
const collection = Astro.url.searchParams.getAll("collection");
const watch = Astro.url.searchParams.getAll("watch");
const arr = Astro.url.searchParams.getAll("arr");
const langs = Astro.url.searchParams.getAll("lang");
const excludedLangs = Astro.url.searchParams.getAll("exclude_lang");
const inList = Astro.url.searchParams.getAll("in_list");
const myRating = parseMyRating(Astro.url);
const page = Number(Astro.url.searchParams.get("page") ?? 1);
const { token, user } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");

let hasTmdbKey = false;
let hasSonarr = false;
if (token) {
  const settings = await api.auth.getSettings(token);
  hasTmdbKey = !!settings?.has_effective_tmdb_key;
  hasSonarr = !!settings?.has_effective_sonarr;
} else {
  const status = await api.profile.publicAccessStatus().catch(() => ({ has_global_tmdb_key: false }));
  hasTmdbKey = status.has_global_tmdb_key;
}

let data: { results: MediaItem[]; total_pages: number; page: number } = { results: [], total_pages: 0, page: 1 };
if (hasTmdbKey) {
  try {
    data = await api.media.tmdbList({
      type: "series",
      category,
      page,
      ...(genre.length ? { genre } : {}),
      ...(excludedGenres.length ? { exclude_genre: excludedGenres } : {}),
      ...(year.length ? { year } : {}),
      ...(minRating ? { min_rating: minRating } : {}),
      ...(status ? { status } : {}),
      ...(collection.length ? { collection } : {}),
      ...(watch.length ? { watch } : {}),
      ...(hasSonarr && arr.length ? { arr } : {}),
      ...(langs.length ? { original_language: langs.join("|") } : {}),
      ...(excludedLangs.length ? { exclude_language: excludedLangs } : {}),
      ...(inList.length ? { in_list: inList } : {}),
      ...(myRating.length ? { my_rating: myRating } : {}),
    }, token);
  } catch (e) {
    console.error("Failed to fetch TMDB show list:", e);
  }
}

const TV_GENRES = [
  "Action & Adventure", "Animation", "Comedy", "Crime", "Documentary",
  "Drama", "Family", "Kids", "Mystery", "News", "Reality",
  "Sci-Fi & Fantasy", "Soap", "Talk", "War & Politics", "Western",
];

const TV_STATUSES = ["Returning Series", "In Production", "Planned", "Ended", "Canceled"];

const LANGUAGES = exploreLanguageOptions();

const currentYear = new Date().getFullYear();
const years = Array.from({ length: currentYear - 1949 }, (_, i) => currentYear - i);

// Build base URL preserving active filters (without page)
const baseParams = new URLSearchParams();
baseParams.set("category", category);
genre.forEach((v) => baseParams.append("genre", v));
excludedGenres.forEach((v) => baseParams.append("exclude_genre", v));
year.forEach((v) => baseParams.append("year", String(v)));
if (minRating) baseParams.set("min_rating", String(minRating));
if (status) baseParams.set("status", status);
collection.forEach((v) => baseParams.append("collection", v));
watch.forEach((v) => baseParams.append("watch", v));
if (hasSonarr) arr.forEach((v) => baseParams.append("arr", v));
langs.forEach((l) => baseParams.append("lang", l));
excludedLangs.forEach((l) => baseParams.append("exclude_lang", l));
inList.forEach((v) => baseParams.append("in_list", v));
myRating.forEach((rating) => baseParams.append("my_rating", String(rating)));
const randomUrl = `/random?kind=explore-shows&${baseParams.toString()}`;
const baseUrl = `/shows?${baseParams.toString()}`;
---

<Base title={m.explore_shows_title()}>
  {user && (
    <div class="flex items-center gap-1 mb-6 bg-zinc-900 border border-zinc-800 rounded-xl p-1 w-fit">
      <a href="/shows" class="px-4 py-1.5 rounded-lg text-sm font-semibold bg-blue-600 text-white transition-colors active:scale-95 active:opacity-70">{m.explore_tab()}</a>
      <a href="/collection/shows" class="px-4 py-1.5 rounded-lg text-sm font-medium text-zinc-400 hover:text-zinc-100 transition-colors active:scale-95 active:opacity-70">{m.explore_my_collection()}</a>
    </div>
  )}
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
    <h1 class="page-title">{m.explore_shows_title()}</h1>

    {hasTmdbKey && (
      <div class="flex items-center gap-3">
        <a href={randomUrl} title="Open a random title" class="flex items-center gap-2 bg-zinc-900 border border-zinc-800 text-zinc-200 text-sm rounded-lg px-3 py-2 hover:border-zinc-600 transition active:scale-95 active:opacity-70">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22"/><path d="m18 2 4 4-4 4"/><path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"/><path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8"/><path d="m18 14 4 4-4 4"/></svg>
          Random
        </a>
        <SortButton
          id="explore-show-category"
          current={category}
          paramKey="category"
          label={m.explore_category()}
          iconPaths={[
            "M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.169.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z",
            "M6 6h.008v.008H6V6Z",
          ]}
          options={[
            { value: "popular", label: m.explore_category_popular() },
            { value: "top_rated", label: m.explore_category_top_rated() },
            { value: "trending", label: m.explore_category_trending() },
          ]}
        />
        <FilterPanel
          id="explore-show-filters"
          basePath="/shows"
          extraParams={{ category }}
          sections={[
            { key: "genre", label: m.filter_genre(), options: sortByLabel(TV_GENRES.map((g) => ({ value: g, label: genreLabel(g) }))), selected: genre, excluded: excludedGenres, tristate: true },
            { key: "year", label: m.filter_year(), options: years.map((y) => ({ value: String(y), label: String(y) })), selected: year.map(String) },
            { key: "min_rating", label: m.filter_rating(), options: [9, 8, 7, 6, 5].map((r) => ({ value: String(r), label: m.filter_rating_min_stars({ rating: r }) })), selected: minRating ? [String(minRating)] : [], multi: false },
            { key: "status", label: m.filter_status(), options: TV_STATUSES.map((s) => ({ value: s, label: showStatusLabel(s) })), selected: status ? [status] : [], multi: false },
            ...(user ? [
              { key: "collection", label: m.filter_collection(), options: [{ value: "in", label: m.filter_in_my_collection() }, { value: "out", label: m.filter_not_in_my_collection() }], selected: collection },
              { key: "watch", label: m.filter_watched(), options: [{ value: "watched", label: m.filter_watched_option() }, { value: "unwatched", label: m.filter_unwatched_option() }, { value: "started", label: "In Progress" }], selected: watch },
              { key: "my_rating", label: m.filter_my_rating(), options: MY_RATING_OPTIONS, selected: myRating.map(String) },
            ] : []),
            ...(hasSonarr ? [{ key: "arr", label: "Sonarr", options: [{ value: "added", label: m.filter_in_sonarr() }, { value: "notadded", label: m.filter_not_in_sonarr() }], selected: arr }] : []),
            { key: "lang", label: m.filter_language(), options: LANGUAGES, selected: langs, excluded: excludedLangs, tristate: true },
            { key: "in_list", label: m.filter_lists(), options: [{ value: "in", label: m.filter_in_a_list() }, { value: "out", label: m.filter_not_in_a_list() }], selected: inList },
          ]}
        />
      </div>
    )}
  </div>

  {!hasTmdbKey ? (
    <div class="p-12 bg-zinc-900/50 border border-zinc-800 rounded-2xl text-center">
      <div class="text-4xl mb-4">📺</div>
      <h2 class="text-xl font-bold text-zinc-100 mb-2">{m.common_tmdb_token_required()}</h2>
      <p class="text-zinc-400 mb-6 max-w-md mx-auto">{m.explore_tmdb_required_body({ type: "series" })}</p>
      <a href="/settings" class="inline-flex px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl transition-all shadow-lg shadow-blue-600/20 active:scale-95">
        {m.common_go_to_settings()}
      </a>
    </div>
  ) : (
    <>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
        {data.results.map(item => <MediaCard item={item} />)}
      </div>

      <Pagination
        currentPage={data.page}
        totalPages={data.total_pages}
        baseUrl={baseUrl}
      />
    </>
  )}
</Base>
