---
import Base from "../../layouts/Base.astro";
import MediaCard from "../../components/MediaCard.astro";
import Pagination from "../../components/Pagination.astro";
import FilterPanel from "../../components/FilterPanel.astro";
import SortButton from "../../components/SortButton.astro";
import { api } from "../../lib/api";
export const prerender = false;

const sort = Astro.url.searchParams.get("sort") ?? "title";
const genres = Astro.url.searchParams.getAll("genre");
const years = Astro.url.searchParams.getAll("year").map(Number).filter((n) => !Number.isNaN(n));
const watched = Astro.url.searchParams.getAll("watched");
const inList = Astro.url.searchParams.get("in_list") ?? "";
const page = Number(Astro.url.searchParams.get("page") ?? 1);
const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");

const data = await api.media.list({
  type: "movie",
  sort,
  page,
  genre: genres,
  year: years,
  watched,
  ...(inList ? { in_list: inList } : {}),
}, token);

const MOVIE_GENRES = [
  "Action", "Adventure", "Animation", "Comedy", "Crime", "Documentary",
  "Drama", "Family", "Fantasy", "History", "Horror", "Music", "Mystery",
  "Romance", "Science Fiction", "Thriller", "War", "Western",
];

const hasFilters = genres.length > 0 || years.length > 0 || watched.length > 0 || !!inList;

// Build base URL preserving active filters (without page)
const baseParams = new URLSearchParams();
baseParams.set("sort", sort);
genres.forEach((g) => baseParams.append("genre", g));
years.forEach((y) => baseParams.append("year", String(y)));
watched.forEach((w) => baseParams.append("watched", w));
if (inList) baseParams.set("in_list", inList);
const randomUrl = `/random?kind=movies&${baseParams.toString()}`;
const baseUrl = `/collection/movies?${baseParams.toString()}`;
---

<Base title="My Movies">
  <div class="flex items-center gap-1 mb-6 bg-zinc-900 border border-zinc-800 rounded-xl p-1 w-fit">
    <a href="/movies" class="px-4 py-1.5 rounded-lg text-sm font-medium text-zinc-400 hover:text-zinc-100 transition-colors active:scale-95 active:opacity-70">Explore</a>
    <a href="/collection/movies" class="px-4 py-1.5 rounded-lg text-sm font-semibold bg-blue-600 text-white transition-colors active:scale-95 active:opacity-70">My Collection</a>
  </div>
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
    <div class="flex items-baseline gap-3">
      <h1 class="page-title">My Movies</h1>
      <span class="text-zinc-500 font-medium">{data.total_results.toLocaleString()} total</span>
    </div>

    <!-- Sort & filter controls -->
    <div class="flex items-center gap-3">
      <a href={randomUrl} title="Open a random title" class="flex items-center gap-2 bg-zinc-900 border border-zinc-800 text-zinc-200 text-sm rounded-lg px-3 py-2 hover:border-zinc-600 transition active:scale-95 active:opacity-70">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22"/><path d="m18 2 4 4-4 4"/><path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"/><path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8"/><path d="m18 14 4 4-4 4"/></svg>
        Random
      </a>
      <SortButton
        id="movie-sort"
        current={sort}
        options={[
          { value: "title", label: "A–Z" },
          { value: "rating", label: "Top" },
          { value: "release_date", label: "Newest" },
          { value: "created_at", label: "Recently Added" },
          { value: "last_watched", label: "Recently Watched" },
        ]}
      />
      <FilterPanel
        id="movie-filters"
        basePath="/collection/movies"
        currentSort={sort}
        sections={[
          { key: "genre", label: "Genre", options: MOVIE_GENRES.map((g) => ({ value: g, label: g })), selected: genres },
          { key: "year", label: "Year", selected: years.map(String), dynamic: true, endpoint: "/api/proxy/media/years?type=movie" },
          { key: "watched", label: "Watched", options: [{ value: "watched", label: "Watched" }, { value: "unwatched", label: "Unwatched" }], selected: watched },
          { key: "in_list", label: "Lists", options: [{ value: "in", label: "In a List" }, { value: "out", label: "Not In a List" }], selected: inList ? [inList] : [], multi: false },
        ]}
      />
    </div>
  </div>

  {data.results.length === 0 ? (
    <div class="bg-zinc-900/50 rounded-2xl p-12 text-center border border-dashed border-zinc-800">
      <div class="text-zinc-500 mb-4 text-lg">
        {hasFilters ? "No movies match the selected filters" : "Your library is empty"}
      </div>
      {!hasFilters && (
        <a href="/settings" class="inline-flex items-center px-6 py-3 bg-zinc-100 text-zinc-950 font-bold rounded-xl hover:bg-zinc-200 transition">
          Set up Sync
        </a>
      )}
    </div>
  ) : (
    <>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
        {data.results.map(item => <MediaCard item={{...item, in_library: true}} />)}
      </div>

      <Pagination
        currentPage={data.page}
        totalPages={data.total_pages}
        baseUrl={baseUrl}
      />
    </>
  )}
</Base>
